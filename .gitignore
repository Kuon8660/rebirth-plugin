# ===== 依赖 / 运行时产物 =====
node_modules/
data/
# tmp/ 下含转生卡渲染产物(tmp/rebirth/)与 AI 立绘(tmp/rebirth/ai/)，均不入库
tmp/

# ===== 本地文档（不入库） =====
docs/

# ===== 运行时配置文件（含敏感 sessionid，不入库） =====
# 实际生效的是 config/*.json；仓库内只保留 *.default.json 默认模板
# （config.js 检测缺失时会从 *.default.json 自动复制生成 config/*.json）
config/*.json
!config/*.default.json

# ===== 种族/职业属性配置（属于内容，必须入库） =====
# config/races/*.json、config/jobs/*.json 一个种族/职业一个文件，
# 启动时由 app/core/data.js 扫描加载（上面的 config/*.json 只匹配 config 直属文件，不会命中子目录）
!config/races/
!config/jobs/
!config/races/*.json
!config/jobs/*.json

# ===== 开发测试草稿 =====
app/apptest.js
